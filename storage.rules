rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    /*
     * Public website media
     *
     * Files under media/ are publicly readable because they are used by:
     * - Product images
     * - Category images
     * - Project images
     * - Company branding
     * - Public downloadable documents
     *
     * All writes must go through the Next.js API using Firebase Admin SDK.
     */
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    /*
     * Deny every other path by default.
     */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}