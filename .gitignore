```gitignore
# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Vercel
.vercel

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env*
!.env.example

# Firebase service accounts and private keys
service-account*.json
firebase-admin*.json
*firebase-adminsdk*.json
*.pem
*.key
*.p12
*.pfx

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# TypeScript generated files
*.tsbuildinfo
next-env.d.ts

# Temporary files
*.tmp
*.temp
*.log
hcs-*-source.txt
.vercel
