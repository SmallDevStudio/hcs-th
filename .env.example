# =========================================================
# HCS Thailand
# Environment Variables Example
# =========================================================
#
# Copy this file to .env.local for local development.
# Never commit .env.local or real secrets.
# =========================================================


# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HCS Thailand


# ---------------------------------------------------------
# Firebase Client SDK
# Firebase Console > Project settings > Your apps > Web app
# These values are exposed to the browser by design.
# ---------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# ---------------------------------------------------------
# Firebase Admin SDK
# Firebase Console > Project settings > Service accounts
#
# Never add NEXT_PUBLIC_ to these variables.
# FIREBASE_ADMIN_PRIVATE_KEY may contain escaped \n values.
# ---------------------------------------------------------

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=


# ---------------------------------------------------------
# Authentication Session
#
# Generate AUTH_SECRET:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# AUTH_SESSION_MAX_AGE is measured in seconds.
# 432000 seconds = 5 days.
# ---------------------------------------------------------

AUTH_SESSION_COOKIE_NAME=hcs_admin_session
AUTH_SESSION_MAX_AGE=432000
AUTH_SECRET=


# ---------------------------------------------------------
# Cache Revalidation
#
# Generate a different random value from AUTH_SECRET.
# Reserved for protected revalidation endpoints.
# ---------------------------------------------------------

REVALIDATE_SECRET=


# ---------------------------------------------------------
# Search Engine Verification Fallback
#
# Primary values are managed in Admin > Site Settings.
# These variables may be used as deployment fallbacks.
# ---------------------------------------------------------

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=


# ---------------------------------------------------------
# Analytics
#
# Optional during local development.
# ---------------------------------------------------------

NEXT_PUBLIC_GA_MEASUREMENT_ID=


# ---------------------------------------------------------
# Super Admin Bootstrap
#
# Add these values temporarily to .env.local.
# Remove BOOTSTRAP_ADMIN_PASSWORD after successful bootstrap.
# Never configure bootstrap credentials in Vercel Production.
# ---------------------------------------------------------

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=


# ---------------------------------------------------------
# Cron
# ---------------------------------------------------------

CRON_SECRET=replace-with-a-random-secret-at-least-32-characters


# ---------------------------------------------------------
# SMTP
# ---------------------------------------------------------

SMTP_SETTINGS_ENCRYPTION_KEY=